<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Forced dark product UI (redesign mock). -->
    <style name="Theme.Cita" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_charcoal</item>
        <item name="colorPrimaryVariant">@color/brand_charcoal_deep</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_yellow</item>
        <item name="colorSecondaryVariant">@color/brand_yellow_dark</item>
        <item name="colorOnSecondary">@color/brand_charcoal_deep</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/on_surface_dark</item>
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorOnBackground">@color/on_surface_dark</item>
        <item name="colorError">@color/brand_error</item>
        <item name="colorOnError">@color/black</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/background_dark</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/surface_dark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:textColor">@color/on_surface_dark</item>
        <item name="materialCardViewStyle">@style/Widget.Cita.Card</item>
        <item name="chipStyle">@style/Widget.Cita.Chip</item>
        <item name="bottomNavigationStyle">@style/Widget.Cita.BottomNav</item>
    </style>

    <style name="Widget.Cita.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface_elevated</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.Cita.Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/cita_chip_bg</item>
        <item name="android:textColor">@color/cita_chip_text</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="chipMinHeight">36dp</item>
    </style>

    <style name="Widget.Cita.BottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemIconTint">@color/bottom_nav_color</item>
        <item name="itemTextColor">@color/bottom_nav_color</item>
        <item name="android:background">@color/surface_dark</item>
        <item name="elevation">0dp</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="Widget.Cita.Button.Yellow" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/brand_yellow</item>
        <item name="android:textColor">@color/brand_charcoal_deep</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Cita.Button.Ghost" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/brand_charcoal_muted</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.Cita.Quote" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <!-- Full-bleed branded splash; bitmap switches via drawable / drawable-night. -->
    <style name="Theme.Cita.Splash" parent="Theme.Cita">
        <item name="android:windowBackground">@drawable/splash_cita</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="horizontal_divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:background">#22FFFFFF</item>
    </style>

    <style name="OverlayButtonCircle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
