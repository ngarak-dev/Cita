<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (light). -->
    <style name="Theme.Cita" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/brand_charcoal</item>
        <item name="colorPrimaryVariant">@color/brand_charcoal_deep</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/brand_yellow</item>
        <item name="colorSecondaryVariant">@color/brand_yellow_dark</item>
        <item name="colorOnSecondary">@color/brand_charcoal_deep</item>
        <!-- Surface / background -->
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/on_surface_light</item>
        <item name="android:colorBackground">@color/background_light</item>
        <item name="colorOnBackground">@color/on_surface_light</item>
        <!-- Error -->
        <item name="colorError">@color/brand_error</item>
        <item name="colorOnError">@color/white</item>
        <!-- Status bar -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="horizontal_divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:background">?android:attr/listDivider</item>
    </style>

    <style name="OverlayButtonCircle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
