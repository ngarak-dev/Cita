<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_charcoal"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widgetLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/daily_drop"
        android:textAllCaps="true"
        android:textColor="@color/brand_yellow"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widgetQuote"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="5"
        android:text="@string/widget_empty"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widgetMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/brand_charcoal_muted"
        android:textSize="11sp"
        android:textStyle="italic" />
</LinearLayout>
